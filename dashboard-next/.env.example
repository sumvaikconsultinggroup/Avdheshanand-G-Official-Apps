# ============================================
# AGM India — Dashboard + API Backend
# ============================================

# ─── Database ─────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
DB_NAME=agm_india

# ─── Authentication ──────────────────────────
JWT_SECRET=your_jwt_secret_min_64_chars_random_string
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3001

# ─── Cloudinary (Media Storage) ──────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Razorpay (Payments) ─────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── WhatsApp (Vaibi / Interakt) ─────────────
WHATSAPP_API_URL=https://api.whatsappbiz.com/v1/public/message/
WHATSAPP_API_KEY=your_vaibi_basic_api_key
WHATSAPP_DONATION_RECEIPT_TEMPLATE=donation_80g_receipt_v1
SAMPLE_DONATION_RECEIPT_URL=https://your-public-file-host/Sample-80G-Receipt.pdf

# ─── OpenAI (AI Chatbot) ─────────────────────
OPENAI_API_KEY=sk-xxxx

# ─── Firebase (Auth + Push Notifications) ────
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"

# ─── Email (SMTP / SendGrid) ─────────────────
# Used by OTP, schedule, volunteer and other nodemailer-based emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ─── Resend (contact form "Write to Swami Ji") ───
# RESEND_API_KEY: create at https://resend.com/api-keys
# RESEND_FROM: a sender on a domain verified in Resend. Until your domain is
#   verified you may use "Swami Avdheshanand G <onboarding@resend.dev>", which
#   can only deliver to the email of your own Resend account.
# CONTACT_NOTIFY_EMAIL: optional inbox that receives a copy of each submission.
RESEND_API_KEY=re_your_api_key
RESEND_FROM=Swami Avdheshanand G <office@avdheshanandg.org>
CONTACT_NOTIFY_EMAIL=office@avdheshanandg.org

# ─── Application ─────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3001
PUBLIC_APP_BASE_URL=https://admin.avdheshanandg.org
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Google Sign-In (verifies the id_token from the app; all client IDs that may mint it) ---
# Web client ID is required; add Android/iOS client IDs too if you build natively.
GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
